# Phase 1 process settings. Copy to .env and export the variables
# before `go run ./cmd/gateway`. The process does not read .env itself.

HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
DEPENDENCY_TIMEOUT=2s

CORE_URL=http://localhost:8081

# Required. Readiness fails closed when Redis or Kafka is unreachable.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

JWT_SECRET=your-local-development-secret

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rombay-gateway

# Accepted Redis durability limit for later idempotency state and webhook jobs:
# local Compose enables AOF with appendfsync everysec and maxmemory-policy noeviction.
# A crash can drop about one second of writes. Eviction is refused so full memory
# fails writes instead of deleting keys. Webhook delivery stays at-least-once.
